# Copy to backend/.env for local development. On Render, set these in the dashboard (never commit real values).

# --- required -------------------------------------------------------------
APP_ENV=development                       # "production" on Render (render.yaml sets it)
MONGO_URL=mongodb://localhost:27017       # Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lingua
JWT_SECRET=                               # at least 32 random characters: openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000        # the website address(es), comma separated, no trailing slash

# --- translation (Claude) --------------------------------------------------
ANTHROPIC_API_KEY=                        # https://console.anthropic.com -> API keys
# TRANSLATION_MODEL=claude-haiku-4-5      # default; if you change the model also set the two prices below
# LLM_PRICE_IN_PER_MTOK=1.0               # USD per million input tokens (used for the cost dashboard)
# LLM_PRICE_OUT_PER_MTOK=5.0
# TRANSLATION_PROVIDER=llm                # llm | selfhosted | mock
# TRANSLATION_CONCURRENCY=8               # max translations running at the same time

# --- file storage (Cloudflare R2 or any S3-compatible service) -------------
# Leave S3_BUCKET empty in development: files go to ./data/uploads. NOT for production (Render's disk is temporary).
S3_BUCKET=
S3_ENDPOINT_URL=                          # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# MAX_UPLOAD_MB=15

# --- optional ---------------------------------------------------------------
OPENAI_API_KEY=                           # enables transcription (and translation) of voice messages
# STT_MODEL=gpt-4o-mini-transcribe
GOOGLE_CLIENT_ID=                         # enables "Continue with Google" (OAuth client of type Web)
ADMIN_EMAIL=                              # creates/keeps one admin account (cost dashboard) when both are set
ADMIN_PASSWORD=                           # at least 12 characters, not reused anywhere else
INVITE_CODE=                              # when set, creating an account (also with Google) requires this code; empty = open sign-up

# --- behind a proxy ---------------------------------------------------------
# Used only for anti-abuse limits. After deploying, log in as admin and open /api/admin/client-ip to check it.
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUST_PROXY_HOPS=1

# --- local demo only (never in production) ----------------------------------
# SEED_DEMO=true
# DEMO_PASSWORD=
